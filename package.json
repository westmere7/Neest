{
  "name": "neest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Neest — local-first browser apartment floor planner with integrated 2D drafting and 3D interior visualization.",
  "scripts": {
    "build:guest": "vite build --config vite.guest.config.ts",
    "predev": "npm run build:guest",
    "dev": "vite",
    "build": "npm run build:guest && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run build:guest && tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "textures": "node tools/fetch-textures.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.5.0",
    "@react-three/fiber": "^9.2.0",
    "dexie": "^4.0.11",
    "fflate": "^0.8.2",
    "immer": "^10.1.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svg2pdf.js": "^2.5.0",
    "three": "^0.178.0",
    "three-gpu-pathtracer": "^0.0.23",
    "three-mesh-bvh": "^0.9.16",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.53.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.178.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
}
