// Neest live rooms. Local: `npm run cloud:dev` (port 8787, the Vite dev server proxies /sync to it).
// Deploy (only when you decide to): `npm run cloud:deploy` after `npx wrangler login`.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "neest-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ProjectRoom" }]
  },
  // SQLite-backed Durable Objects are included in the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }],
  "observability": { "enabled": true }
}
