# `npm run dev` talks to the team's live-editing server too, so everyone signs in with their own account and sees
# the projects the team shares. Not a secret. To work on the server itself (`npm run cloud:dev`, port 8787), put
# VITE_NEEST_SYNC_URL=/sync in .env.development.local (git-ignored): it wins over this file.
VITE_NEEST_SYNC_URL=https://neest-sync.nguyentuandanh-7.workers.dev
